# Auth.js / NextAuth v5 Configurations
# Run 'openssl rand -base64 32' to generate a secure secret
AUTH_SECRET="your_nextauth_secret_here"

# Google OAuth Client Credentials
# Create these at Google Cloud Console (https://console.cloud.google.com)
# Set your Authorized Redirect URI to: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID="your_google_client_id_here"
AUTH_GOOGLE_SECRET="your_google_client_secret_here"

# Alternative environment keys supported by the codebase:
GOOGLE_CLIENT_ID="your_google_client_id_here"
GOOGLE_CLIENT_SECRET="your_google_client_secret_here"

# Base Application URL
# Use http://localhost:3000 in development, or your Vercel URL in production
NEXTAUTH_URL="http://localhost:3000"
